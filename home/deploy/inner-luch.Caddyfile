{
    admin off
    auto_https off
}
:8080 {
    handle /home {
        redir /home/ 308
    }
    handle_path /home/* {
        reverse_proxy luch-home-r7-public:8080 {
            # External canonical Caddy sets trusted X-Forwarded-For.
            # Avoid aggregating every visitor under the Docker edge IP.
            header_up X-LUCH-Client-IP {http.request.header.X-Forwarded-For}
            header_up -Authorization
        }
        header Cache-Control "no-store"
        header X-Content-Type-Options "nosniff"
    }
    handle {
        root * /site
        file_server
    }
}
